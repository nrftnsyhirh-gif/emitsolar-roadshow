# Copy this file to ".env" and fill in your real values.
# NEVER commit the real ".env" file to Git — only this .example file.

AIRTABLE_TOKEN=pat_your_real_token_here
AIRTABLE_BASE_ID=app_your_real_base_id_here
AIRTABLE_TABLE_NAME=Roadshow Requests

TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Local dev port (Cloud Run sets its own PORT automatically in production)
PORT=8080
